{
  "name": "Kavach demo box",
  "image": "mcr.microsoft.com/devcontainers/go:1.22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" }
  },
  "postCreateCommand": "make build && pip install flask gunicorn aiohttp",
  "forwardPorts": [9000],
  "portsAttributes": { "9000": { "label": "Aurora Nights demo app", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": { "extensions": ["golang.go"] }
  }
}
